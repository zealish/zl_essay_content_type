<odoo>
    <record id="essay_own_attempt_rule" model="ir.rule">
        <field name="name">Students: own essay attempts</field>
        <field name="model_id" ref="model_slide_slide_essay_attempt"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal')), (4, ref('base.group_user'))]"/>
    </record>
    <record id="essay_instructor_attempt_rule" model="ir.rule">
        <field name="name">Instructors: course essay attempts</field>
        <field name="model_id" ref="model_slide_slide_essay_attempt"/>
        <field name="domain_force">['|', ('slide_id.channel_id.user_id', '=', user.id), ('slide_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('website_slides.group_website_slides_officer'))]"/>
    </record>
    <record id="essay_admin_attempt_rule" model="ir.rule">
        <field name="name">Administrators: all essay attempts</field>
        <field name="model_id" ref="model_slide_slide_essay_attempt"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
